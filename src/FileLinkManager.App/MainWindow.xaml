<Window x:Class="FileLinkManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文件链接管理器"
        Width="1180"
        Height="760"
        MinWidth="960"
        MinHeight="640"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190.4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <StackPanel Margin="14,28">
                <TextBlock Text="文件链接管理器"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="White"
                           TextWrapping="NoWrap"
                           Margin="4,0,4,6" />
                <TextBlock Text="Windows 原生链接工具"
                           FontSize="12"
                           Foreground="{StaticResource SidebarSecondaryBrush}"
                           TextWrapping="NoWrap"
                           Margin="4,0,4,32" />

                <Button x:Name="CreateNavigationButton" Content="创建链接"
                        Style="{StaticResource NavigationButtonStyle}"
                        Click="ShowCreatePageClick" />
                <Button x:Name="RecordsNavigationButton"
                        Content="链接记录"
                        Style="{StaticResource NavigationButtonStyle}"
                        Click="ShowRecordsPageClick" />
                <Button x:Name="AboutNavigationButton"
                        Content="关于"
                        Style="{StaticResource NavigationButtonStyle}"
                        Click="ShowAboutPageClick" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="34,28,34,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="PageTitle" FontSize="28" FontWeight="SemiBold" />
            <TextBlock x:Name="PageSubtitle"
                       Grid.Row="1"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="14"
                       Margin="0,6,0,22" />
            <ContentControl x:Name="MainContent" Grid.Row="2" />
        </Grid>
    </Grid>
</Window>
