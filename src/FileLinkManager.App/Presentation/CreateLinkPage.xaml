<UserControl x:Class="FileLinkManager.App.Presentation.CreateLinkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="链接类型" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="每种类型的作用和限制都会显示在卡片上。"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Margin="0,4,0,12" />

            <ItemsControl ItemsSource="{Binding TypeCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SelectTypeCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource TypeCardButtonStyle}"
                                Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="0,8,0,0" />
                                <TextBlock Text="{Binding Limitation}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="12"
                                           Margin="0,12,0,0" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    Padding="18"
                    Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Text="路径" FontSize="17" FontWeight="SemiBold" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="源路径（已有文件或目录）" FontWeight="SemiBold" />
                        <Button Grid.Column="1"
                                Content="选择源"
                                Command="{Binding BrowseSourceCommand}"
                                Padding="14,6"
                                Margin="12,0,0,0" />
                        <TextBox Grid.Row="1"
                                 Grid.ColumnSpan="2"
                                 Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding IsBusy}"
                                 Style="{StaticResource PathTextBoxStyle}"
                                 Margin="0,6,0,4" />
                        <ItemsControl Grid.Row="2"
                                      Grid.ColumnSpan="2"
                                      ItemsSource="{Binding SourceValidationErrors}"
                                      Margin="0,0,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="{StaticResource ErrorBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0">
                                        <Run Text="•  " />
                                        <Run Text="{Binding Path=., Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Grid.Row="3"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding SourceValidationStatus}"
                                   Foreground="{StaticResource SuccessBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,12" />

                        <TextBlock Grid.Row="4" Text="链接路径（必须不存在）" FontWeight="SemiBold" />
                        <Button Grid.Row="4"
                                Grid.Column="1"
                                Content="选择位置"
                                Command="{Binding BrowseLinkLocationCommand}"
                                Padding="14,6"
                                Margin="12,0,0,0" />
                        <TextBox Grid.Row="5"
                                 Grid.ColumnSpan="2"
                                 Text="{Binding LinkPath, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding IsBusy}"
                                 Style="{StaticResource PathTextBoxStyle}"
                                 Margin="0,6,0,4" />
                        <ItemsControl Grid.Row="6"
                                      Grid.ColumnSpan="2"
                                      ItemsSource="{Binding LinkValidationErrors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="{StaticResource ErrorBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0">
                                        <Run Text="•  " />
                                        <Run Text="{Binding Path=., Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Grid.Row="7"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding LinkValidationStatus}"
                                   Foreground="{StaticResource SuccessBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding GeneralValidationErrors}" Margin="0,0,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="{StaticResource ErrorBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0">
                                    <Run Text="•  " />
                                    <Run Text="{Binding Path=., Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" Padding="18" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="记录信息（选填）" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="名称只用于软件记录，不修改磁盘路径；创建后可在链接记录中编辑。"
                               TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,6,0,12" />
                    <StackPanel DataContext="{Binding MetadataEditor}" IsEnabled="{Binding IsEnabled}">
                        <DockPanel>
                            <TextBlock Text="自定义名称" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TextElementCount, StringFormat={}{0}/20}" HorizontalAlignment="Right" />
                        </DockPanel>
                        <TextBox Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PathTextBoxStyle}" Margin="0,6,0,4" />
                        <TextBlock Text="{Binding NameError}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="分组" FontWeight="SemiBold" Margin="0,10,0,6" />
                        <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" DisplayMemberPath="DisplayName" />
                    </StackPanel>
                    <Button Content="新建分组" Command="{Binding NewGroupCommand}" HorizontalAlignment="Left" Padding="12,6" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource AccentLightBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    Padding="16"
                    Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="创建预览" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PreviewText}"
                               TextWrapping="Wrap"
                               FontSize="15"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Background="#FFF4CE"
                    BorderBrush="#D9A441"
                    BorderThickness="1"
                    Padding="14"
                    Margin="0,14,0,0"
                    Visibility="{Binding StorageAccess.IsReadOnly, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="记录存储处于只读模式，创建链接已禁用。"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StorageAccess.Message}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ResultMessage}"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,18,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="重试登记"
                            Command="{Binding RetryRegistrationCommand}"
                            Padding="16,9"
                            Margin="0,0,10,0" />
                    <Button Content="创建链接"
                            Command="{Binding CreateCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
