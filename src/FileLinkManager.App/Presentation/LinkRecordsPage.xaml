<UserControl x:Class="FileLinkManager.App.Presentation.LinkRecordsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="链接记录" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="查看已创建链接的状态，并安全删除链接入口。"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="重新检查"
                        Command="{Binding InspectCommand}"
                        Padding="16,8" />
            </Grid>

            <Border Background="#FFF4CE"
                    BorderBrush="#D9A441"
                    BorderThickness="1"
                    Padding="14"
                    Margin="0,14,0,0"
                    Visibility="{Binding StorageAccess.IsReadOnly, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="记录存储处于只读模式，检查结果不会写回文件。"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StorageAccess.Message}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        Padding="16"
                        Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="当前有效链接" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding CurrentValid}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        Padding="16"
                        Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="历史创建总数" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding HistoricalTotal}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    Padding="16"
                    Margin="0,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="设备" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding Devices}"
                                  SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  IsEnabled="{Binding CanEditFilters}"
                                  Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="状态" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding StatusOptions}"
                                  SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  IsEnabled="{Binding CanEditFilters}"
                                  Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="搜索源路径或链接路径" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding IsBusy}"
                                 Style="{StaticResource PathTextBoxStyle}"
                                 Margin="0,6,0,0" />
                    </StackPanel>
                    <Button Grid.Column="3"
                            Content="清除筛选"
                            Command="{Binding ClearFiltersCommand}"
                            Padding="14,8"
                            VerticalAlignment="Bottom" />
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Records}" Margin="0,18,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                Padding="16"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,18,0">
                                    <TextBlock Text="{Binding LinkPath}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SourcePath}"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding StatusReasonDisplay}"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,18,0">
                                    <TextBlock Text="{Binding TypeDisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding StatusDisplayName}" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding CreatedAtDisplay}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding LastCheckedAtDisplay}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,3,0,0" />
                                    <TextBlock Text="离线设备快照"
                                               Visibility="{Binding IsOfflineSnapshot, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Button Content="打开目录"
                                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}"
                                            Padding="12,6" />
                                    <Button Content="{Binding DeleteActionDisplayName}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}"
                                            Padding="12,6"
                                            Margin="0,8,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="暂无符合条件的记录。"
                       Visibility="{Binding Records.Count, Converter={StaticResource ZeroToVisibilityConverter}}"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Margin="0,8,0,0" />
            <TextBlock Text="{Binding ResultMessage}"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
