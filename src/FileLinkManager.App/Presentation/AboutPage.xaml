<UserControl x:Class="FileLinkManager.App.Presentation.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="关于文件链接管理器" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="使用 Windows 原生能力管理文件和目录链接。"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Margin="0,4,0,18" />

            <Border Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    Padding="18">
                <StackPanel>
                    <TextBlock Text="应用信息" FontSize="16" FontWeight="SemiBold" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="版本" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding VersionText}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Row="1" Text="运行平台" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,10,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Windows x64" HorizontalAlignment="Right" Margin="0,10,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    Padding="18"
                    Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="当前设备" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DeviceDisplayName}" FontSize="15" Margin="0,12,0,0" />
                    <TextBlock Text="设备身份摘要（SHA-256 前 12 位）" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,5,0,0" />
                    <TextBlock Text="{Binding DeviceKeySummary}" FontFamily="Consolas" Margin="0,3,0,0" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    Padding="18"
                    Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="便携数据" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="数据目录" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding DataRootPath}" TextWrapping="Wrap" Margin="0,3,0,0" />
                    <TextBlock Text="主数据文件" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding DataFilePath}" TextWrapping="Wrap" Margin="0,3,0,0" />
                    <TextBlock Text="最近备份文件" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding BackupFilePath}" TextWrapping="Wrap" Margin="0,3,0,0" />
                    <Button Content="打开数据目录（包含备份）"
                            Command="{Binding OpenDataFolderCommand}"
                            Padding="16,8"
                            HorizontalAlignment="Left"
                            Margin="0,16,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding ResultMessage}"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
